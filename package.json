{
  "name": "synaxis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test tests/unit.test.ts",
    "test:rls": "node --env-file=.env.local tests/rls.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types typescript --remote > src/lib/database.types.ts",
    "assets:placeholders": "node scripts/make-placeholders.mjs",
    "assets:process": "node scripts/process-assets.mjs",
    "make-admin": "node --env-file=.env.local scripts/make-admin.mjs",
    "check:live": "node --env-file=.env.local scripts/check-live.mjs",
    "db:types:local": "supabase gen types typescript --local > src/lib/database.types.ts",
    "decor:build": "node --import tsx scripts/build-decor.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "7.0.9",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.6",
    "@react-email/components": "1.0.12",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "jsqr": "1.4.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "posthog-js": "1.455.4",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.92.0",
    "resend": "6.39.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "potrace": "2.1.8",
    "supabase": "3.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
