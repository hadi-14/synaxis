# Copy to .env.local (dev) or set in Vercel (prod).
NEXT_PUBLIC_SITE_URL=https://synaxis.example.com

# Supabase: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Resend (transactional + bulk email). Verify your sending domain in Resend first.
RESEND_API_KEY=re_...
EMAIL_FROM="Synaxis <hello@your-domain.pk>"
EMAIL_REPLY_TO=synaxis@your-domain.pk
# Comma-separated: who receives sponsor inquiries and admin notifications
ADMIN_NOTIFY_EMAILS=president@example.com,vp@example.com
